  {
    "id": "maven-acme-open",
    "message": "How many OPEN deals does Acme Corporation have? Report the count, stages, and whether recorded amounts are available. Do not list every deal or estimate missing amounts.",
    "required_calls": [
      {
        "tool_name": "crm_search_accounts",
        "arguments": {
          "company_name": "Acme Corporation"
        }
      },
      {
        "tool_name": "crm_get_deals",
        "arguments": {
          "stage": "OPEN"
        }
      }
    ],
    "expected_records": [
      {
        "tool_name": "crm_get_deals",
        "id_field": "name",
        "ids": [
          "Maven S3W6Q07M - GTX Plus Pro",
          "Maven 7TI1WTV9 - GTXPro",
          "Maven B3A6VXVQ - GTX Basic",
          "Maven SP9W5IND - MG Special",
          "Maven EMH2I8XE - MG Advanced",
          "Maven LDQITW5C - MG Advanced",
          "Maven MG1YUTUE - MG Special",
          "Maven 0N11U6L3 - GTX Plus Basic",
          "Maven VAM56BG4 - GTX Plus Basic",
          "Maven MI3MV7PU - MG Advanced"
        ]
      }
    ],
    "answer_patterns": [
      "\\b10\\b",
      "unavailable|missing|not .*record|not .*provided"
    ],
    "forbidden_tools": [
      "crm_get_deals_batch"
    ]
  },
  {
    "id": "maven-unknown-company",
    "message": "Find the company Definitely Absent Maven Fixture 987654.",
    "required_calls": [
      {
        "tool_name": "crm_search_accounts",
        "arguments": {
          "company_name": "Definitely Absent Maven Fixture 987654"
        }
      }
    ],
    "expected_records": [
      {
        "tool_name": "crm_search_accounts",
        "id_field": "company_name",
        "ids": []
      }
    ],
    "forbidden_tools": [
      "crm_get_deals",
      "crm_get_contacts"
    ],
    "answer_patterns": [
      "no .*match|could not find|couldn't find|not found|no .*company"
    ]
  },
  {
    "id": "maven-no-customer-contacts",
