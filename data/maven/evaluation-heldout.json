[
  {
    "id": "maven-heldout-cancity-open",
    "message": "How many OPEN deals does Cancity have? Report the count, stages, and whether recorded amounts are available. Do not list every deal or estimate missing amounts.",
    "required_calls": [
      {
        "tool_name": "crm_search_accounts",
        "arguments": {
          "company_name": "Cancity"
        }
      },
      {
        "tool_name": "crm_get_deals",
        "arguments": {
          "stage": "OPEN"
        }
      }
    ],
    "expected_records": [
      {
        "tool_name": "crm_get_deals",
        "id_field": "name",
        "ids": [
          "Maven WW1WV7IT - GTXPro",
          "Maven 3FWZBSW1 - MG Special",
          "Maven RD6Y5R4P - MG Special",
          "Maven 5UFU5IO4 - MG Special",
          "Maven CLRPASVW - GTX Basic",
          "Maven 58W7CZGD - GTXPro",
          "Maven NXXKM7C7 - GTX Plus Basic",
          "Maven J5IXJWVU - MG Advanced"
        ]
      }
    ],
    "answer_patterns": [
      "\\b8\\b",
      "unavailable|missing|not .*record|not .*provided"
    ],
    "forbidden_tools": [
      "crm_get_deals_batch"
    ]
  },
